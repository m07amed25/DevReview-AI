// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output   = "../src/server/db/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  banned        Boolean   @default(false)
  bannedReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  repositories   Repository[]
  reviews        Review[]
  threadComments ReviewThreadComment[]
  teamMembers    TeamMember[]
  notifications  Notification[]
  reviewFeedbacks ReviewFeedback[]
  reviewRules     ReviewRule[]
  auditLogs       AuditLog[]
  customRoles     UserCustomRole[]
  commentReactions ReviewThreadCommentReaction[]
  reviewApprovals  ReviewApproval[]
  assignedReviews  ReviewAssignment[] @relation("ReviewAssignee")
  assignedByMe     ReviewAssignment[] @relation("ReviewAssigner")

  // Code review preferences
  reviewDepth            String  @default("standard")
  defaultLanguage        String  @default("auto")
  autoReview             Boolean @default(false)
  includeSecurityChecks  Boolean @default(true)
  includePerfSuggestions Boolean @default(true)

  // Notification preferences
  emailNotifications            Boolean @default(true)
  notifyTeamInvites             Boolean @default(true)
  notifyTeamMemberAdded         Boolean @default(true)
  notifyReviewCompleted         Boolean @default(true)
  notifyReviewFailed            Boolean @default(true)
  notifyScheduledScanCompleted  Boolean @default(false)
  notifyReviewAssigned          Boolean @default(true)
  notifyReviewApproved          Boolean @default(true)
  notifyReviewChangesRequested  Boolean @default(true)
  notificationSoundEnabled      Boolean @default(false)
  desktopNotifications          Boolean @default(true)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Repository {
  id        String   @id @default(cuid())
  userId    String
  teamId    String?
  githubId  Int
  name      String
  fullName  String
  private   Boolean @default(false)
  htmlUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  reviews   Review[]
  webhookConfig        WebhookConfig?
  scheduledScanConfig  ScheduledScanConfig?
  githubComments       GitHubComment[]
  branchProtectionRecs BranchProtectionRecommendation[]
  diagrams             Diagram[]
  reviewRules          ReviewRule[]

  @@unique([userId, githubId])
  @@index([teamId])
}

model Review {
  id              String   @id @default(cuid())
  repositoryId    String
  userId          String
  prNumber        Int
  prTitle         String
  prUrl           String
  status          ReviewStatus @default(PENDING)
  summary         String?      @db.Text
  riskScore       Int?
  comments        Json?
  qualityMetrics  Json?
  error           String?
  parentReviewId   String?
  resolvedComments String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentReview Review?      @relation("ReviewChain", fields: [parentReviewId], references: [id], onDelete: SetNull)
  childReviews Review[]     @relation("ReviewChain")
  threads      ReviewThread[]
  githubComment     GitHubComment?
  githubStatusCheck GitHubStatusCheck?
  feedbacks         ReviewFeedback[]
  approvals         ReviewApproval[]
  assignments       ReviewAssignment[]
  securityIssues    SecurityIssue[]

  @@index([repositoryId])
  @@index([userId])
  @@index([status])
  @@index([parentReviewId])
}

model ReviewFeedback {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  rating    Int      // 1 (up) or -1 (down)
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

enum SecuritySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum SecurityIssueType {
  VULNERABILITY      // CVE from dependency scan
  SECRET_EXPOSURE    // API keys, tokens, passwords
  OWASP_TOP_10      // OWASP pattern detection
  CODE_QUALITY      // Security-related code quality
  CWE               // Common Weakness Enumeration
}

model SecurityIssue {
  id              String             @id @default(cuid())
  reviewId        String
  severity        SecuritySeverity
  type            SecurityIssueType  @default(CODE_QUALITY)
  cveId           String?
  cweId           String?
  packageName     String?            // For dependency vulnerabilities
  packageVersion  String?
  title           String
  description     String             @db.Text
  remediation     String             @db.Text
  affectedLines   Json               // {file: string, startLine: number, endLine: number}[]
  falsePositive   Boolean            @default(false)
  resolved        Boolean            @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  review          Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([reviewId, severity])
  @@index([severity, resolved])
  @@index([cveId])
  @@map("security_issue")
}

model ReviewThread {
  id         String   @id @default(cuid())
  reviewId   String
  file       String
  line       Int
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  review     Review               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comments   ReviewThreadComment[]

  @@index([reviewId])
}

model ReviewThreadComment {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread    ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions ReviewThreadCommentReaction[]

  @@index([threadId])
  @@index([userId])
}

model ReviewThreadCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String   @db.VarChar(10)
  createdAt DateTime @default(now())

  comment   ReviewThreadComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("review_thread_comment_reaction")
}

enum ReviewStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewApprovalState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

enum AssignmentPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ReviewApproval {
  id        String              @id @default(cuid())
  reviewId  String
  userId    String
  state     ReviewApprovalState
  body      String?             @db.Text
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@map("review_approval")
}

model ReviewAssignment {
  id          String             @id @default(cuid())
  reviewId    String
  assigneeId  String
  assignedBy  String
  dueDate     DateTime?
  priority    AssignmentPriority @default(MEDIUM)
  status      AssignmentStatus   @default(PENDING)
  note        String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  review      Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  assignee    User   @relation("ReviewAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigner    User   @relation("ReviewAssigner", fields: [assignedBy], references: [id], onDelete: Cascade)

  @@unique([reviewId, assigneeId])
  @@index([reviewId])
  @@index([assigneeId])
  @@map("review_assignment")
}


model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TeamMember[]
  repositories  Repository[]
  actions       TeamAction[]
  reviewRules   ReviewRule[]
}

model TeamMember {
  id        String     @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole   @default(MEMBER)
  createdAt DateTime   @default(now())

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum ActionType {
  INVITE_MEMBER
  REMOVE_MEMBER
  UPDATE_ROLE
  SHARE_REPOSITORY
  UNSHARE_REPOSITORY
  DELETE_TEAM
  REVIEW_PR
  APPROVE_DISCUSSION
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
}

model TeamAction {
  id          String      @id @default(cuid())
  teamId      String
  actionType  ActionType
  status      ActionStatus @default(PENDING)
  requestedBy String      // userId of requester
  targetUserId String?    // userId affected by the action
  targetRepoId String?   // repositoryId affected by the action
  metadata    Json?       // additional data like email, role, etc.
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  resolvedAt  DateTime?
  resolvedBy  String?

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([requestedBy])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

enum NotificationType {
  TEAM_INVITE
  TEAM_MEMBER_ADDED
  REVIEW_COMPLETED
  REVIEW_FAILED
  SCHEDULED_SCAN_COMPLETED
  REVIEW_ASSIGNED
  REVIEW_APPROVED
  REVIEW_CHANGES_REQUESTED
}


enum ScanCadence {
  DAILY
  WEEKLY
}

enum ScanRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum GitHubCheckState {
  PENDING
  SUCCESS
  FAILURE
  ERROR
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

model WebhookConfig {
  id              String   @id @default(cuid())
  repositoryId    String   @unique
  enabled         Boolean  @default(false)
  githubWebhookId Int?
  /// Optional numeric risk-score threshold (0–100). Reviews with riskScore >= this
  /// value fail the GitHub branch-protection status check. NULL = use the default
  /// heuristic (fail on any critical/high severity finding).
  scoreThreshold  Int?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("webhook_config")
}

model ScheduledScanConfig {
  id           String      @id @default(cuid())
  repositoryId String      @unique
  enabled      Boolean     @default(false)
  cadence      ScanCadence @default(WEEKLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runs       ScheduledScanRun[]

  @@map("scheduled_scan_config")
}

model ScheduledScanRun {
  id            String        @id @default(cuid())
  configId      String
  triggeredAt   DateTime      @default(now())
  completedAt   DateTime?
  status        ScanRunStatus @default(RUNNING)
  reviewsQueued Int           @default(0)
  summary       String?

  config ScheduledScanConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@map("scheduled_scan_run")
}

model GitHubComment {
  id             String @id @default(cuid())
  reviewId       String @unique
  githubReviewId BigInt
  prNumber       Int
  repositoryId   String
  commitSha      String
  findingCount   Int    @default(0)

  createdAt DateTime @default(now())

  review     Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([repositoryId, prNumber])
  @@map("github_comment")
}

model GitHubStatusCheck {
  id        String           @id @default(cuid())
  reviewId  String           @unique
  commitSha String
  state     GitHubCheckState @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("github_status_check")
}

model BranchProtectionRecommendation {
  id           String                 @id @default(cuid())
  repositoryId String
  rule         String
  rationale    String                 @db.Text
  priority     RecommendationPriority
  dismissed    Boolean                @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("branch_protection_recommendation")
}


enum DiagramType {
  ERD
  CLASS
  USE_CASE
}

enum DiagramStatus {
  PENDING
  COMPLETED
  FAILED
}

model Diagram {
  id          String        @id @default(cuid())
  repositoryId String
  type        DiagramType
  status      DiagramStatus @default(PENDING)
  definition  String?       @db.Text
  nodes       Json?
  edges       Json?
  error       String?
  generatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  repository  Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, type])
  @@index([repositoryId])
}


enum RuleSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model ReviewRule {
  id           String       @id @default(cuid())
  name         String
  description  String       @db.Text
  pattern      String?
  severity     RuleSeverity @default(MEDIUM)
  repositoryId String?
  teamId       String?
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userId       String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository?  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([repositoryId])
  @@index([teamId])
  @@map("review_rule")
}

model SystemSettings {
  id              String   @id @default("global")
  maintenanceMode Boolean  @default(false)
  // Data retention policies (0 = disabled / keep forever)
  reviewRetentionDays   Int @default(0)
  auditLogRetentionDays Int @default(0)
  sessionRetentionDays  Int @default(0)
  updatedAt       DateTime @updatedAt

  @@map("system_settings")
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  subject   String?
  message   String   @db.Text
  type      String   @default("SUPPORT")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@map("support_message")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  country    String?
  city       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// SSO provider table — schema required by @better-auth/sso
// oidcConfig / samlConfig are JSON strings managed by the plugin
model SsoProvider {
  id             String   @id @default(cuid())
  issuer         String
  domain         String
  oidcConfig     String?  @db.Text
  samlConfig     String?  @db.Text
  userId         String
  providerId     String   @unique
  organizationId String?
  // admin UI display fields (not used by better-auth internally)
  name           String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sso_provider")
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // permission flags
  canViewReviews        Boolean @default(true)
  canTriggerReviews     Boolean @default(false)
  canManageRepositories Boolean @default(false)
  canManageTeams        Boolean @default(false)
  canViewAnalytics      Boolean @default(false)
  canManageUsers        Boolean @default(false)
  canAccessAdmin        Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserCustomRole[]

  @@map("custom_role")
}

model UserCustomRole {
  id       String     @id @default(cuid())
  userId   String
  roleId   String
  assignedAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_custom_role")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/// Coupon / promo codes that grant a discount on any or a specific plan.
model Discount {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  /// Percentage (0-100) for PERCENTAGE; dollar amount for FIXED.
  value       Float
  /// Null = applies to all plans; "free" | "pro" | "ultra" = specific plan.
  planId      String?
  /// Null = unlimited uses.
  maxUses     Int?
  usedCount   Int          @default(0)
  active      Boolean      @default(true)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([code])
  @@index([active])
  @@map("discount")
}

/// Per-email price overrides — grant a specific user a custom price on a plan.
model UserPriceOverride {
  id                   String    @id @default(cuid())
  email                String
  /// "free" | "pro" | "ultra"
  planId               String
  overrideMonthlyPrice Float?
  overrideYearlyPrice  Float?
  reason               String?
  active               Boolean   @default(true)
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([email, planId])
  @@index([email])
  @@map("user_price_override")
}
model PartnerDomain {
  id                   String    @id @default(cuid())
  /// e.g. "acme.com" — stored lowercase, without the leading @
  domain               String    @unique
  companyName          String
  /// "free" | "pro" | "ultra"
  planId               String
  overrideMonthlyPrice Float?
  overrideYearlyPrice  Float?
  /// Internal note visible only to admins
  note                 String?
  active               Boolean   @default(true)
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([domain])
  @@index([active])
  @@map("partner_domain")
}

/// Editable plan definitions — prices, features, limits (id is "free" | "pro" | "ultra").
model PricingPlan {
  id           String   @id              // "free", "pro", "ultra"
  name         String
  tagline      String
  monthlyPrice Float
  visible      Boolean  @default(true)
  highlight    Boolean  @default(false)
  features     String[]
  reposLimit   Int?                      // null = unlimited
  reviewsLimit Int?                      // null = unlimited
  seatsLimit   Int?                      // null = unlimited
  privateRepos Boolean  @default(false)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("pricing_plan")
}

/// Single-row global pricing configuration (id is always "global").
model PricingSettings {
  id                   String   @id @default("global")
  pricingEnabled       Boolean  @default(true)
  annualDiscount       Int      @default(20)
  trialDays            Int      @default(14)
  trialPlan            String   @default("pro")
  gracePeriodDays      Int      @default(3)
  refundEnabled        Boolean  @default(true)
  refundWindowDays     Int      @default(14)
  taxEnabled           Boolean  @default(false)
  taxRate              Float    @default(0)
  promoCodesAtCheckout Boolean  @default(true)
  freeSignupEnabled    Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("pricing_settings")
}
