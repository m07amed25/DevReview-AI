// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../src/server/db/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  repositories    Repository[]
  reviews         Review[]
  threadComments  ReviewThreadComment[]
  teamMembers     TeamMember[]
  notifications   Notification[]
  reviewFeedbacks ReviewFeedback[]

  // Code review preferences
  reviewDepth            String  @default("standard")
  defaultLanguage        String  @default("auto")
  autoReview             Boolean @default(false)
  includeSecurityChecks  Boolean @default(true)
  includePerfSuggestions Boolean @default(true)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Repository {
  id        String   @id @default(cuid())
  userId    String
  teamId    String?
  githubId  Int
  name      String
  fullName  String
  private   Boolean  @default(false)
  htmlUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                 Team?                            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  reviews              Review[]
  webhookConfig        WebhookConfig?
  scheduledScanConfig  ScheduledScanConfig?
  githubComments       GitHubComment[]
  branchProtectionRecs BranchProtectionRecommendation[]
  diagrams             Diagram[]

  @@unique([userId, githubId])
  @@index([teamId])
}

model Review {
  id             String       @id @default(cuid())
  repositoryId   String
  userId         String
  prNumber       Int
  prTitle        String
  prUrl          String
  status         ReviewStatus @default(PENDING)
  summary        String?      @db.Text
  riskScore      Int?
  comments       Json?
  qualityMetrics Json?
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  repository        Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads           ReviewThread[]
  githubComment     GitHubComment?
  githubStatusCheck GitHubStatusCheck?
  feedbacks         ReviewFeedback[]

  @@index([repositoryId])
  @@index([userId])
  @@index([status])
}

model ReviewFeedback {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  rating    Int // 1 (up) or -1 (down)
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model ReviewThread {
  id        String   @id @default(cuid())
  reviewId  String
  file      String
  line      Int
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review   Review                @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comments ReviewThreadComment[]

  @@index([reviewId])
}

model ReviewThreadComment {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([userId])
}

enum ReviewStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  repositories Repository[]
  actions      TeamAction[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum ActionType {
  INVITE_MEMBER
  REMOVE_MEMBER
  UPDATE_ROLE
  SHARE_REPOSITORY
  UNSHARE_REPOSITORY
  DELETE_TEAM
  REVIEW_PR
  APPROVE_DISCUSSION
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
}

model TeamAction {
  id           String       @id @default(cuid())
  teamId       String
  actionType   ActionType
  status       ActionStatus @default(PENDING)
  requestedBy  String // userId of requester
  targetUserId String? // userId affected by the action
  targetRepoId String? // repositoryId affected by the action
  metadata     Json? // additional data like email, role, etc.
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?
  resolvedBy   String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([requestedBy])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

enum NotificationType {
  TEAM_INVITE
  TEAM_MEMBER_ADDED
  REVIEW_COMPLETED
  REVIEW_FAILED
  SCHEDULED_SCAN_COMPLETED
}

enum ScanCadence {
  DAILY
  WEEKLY
}

enum ScanRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum GitHubCheckState {
  PENDING
  SUCCESS
  FAILURE
  ERROR
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

model WebhookConfig {
  id              String  @id @default(cuid())
  repositoryId    String  @unique
  enabled         Boolean @default(false)
  githubWebhookId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("webhook_config")
}

model ScheduledScanConfig {
  id           String      @id @default(cuid())
  repositoryId String      @unique
  enabled      Boolean     @default(false)
  cadence      ScanCadence @default(WEEKLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runs       ScheduledScanRun[]

  @@map("scheduled_scan_config")
}

model ScheduledScanRun {
  id            String        @id @default(cuid())
  configId      String
  triggeredAt   DateTime      @default(now())
  completedAt   DateTime?
  status        ScanRunStatus @default(RUNNING)
  reviewsQueued Int           @default(0)
  summary       String?

  config ScheduledScanConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@map("scheduled_scan_run")
}

model GitHubComment {
  id             String @id @default(cuid())
  reviewId       String @unique
  githubReviewId Int
  prNumber       Int
  repositoryId   String
  commitSha      String
  findingCount   Int    @default(0)

  createdAt DateTime @default(now())

  review     Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([repositoryId, prNumber])
  @@map("github_comment")
}

model GitHubStatusCheck {
  id        String           @id @default(cuid())
  reviewId  String           @unique
  commitSha String
  state     GitHubCheckState @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("github_status_check")
}

model BranchProtectionRecommendation {
  id           String                 @id @default(cuid())
  repositoryId String
  rule         String
  rationale    String                 @db.Text
  priority     RecommendationPriority
  dismissed    Boolean                @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("branch_protection_recommendation")
}

enum DiagramType {
  ERD
  CLASS
  USE_CASE
}

enum DiagramStatus {
  PENDING
  COMPLETED
  FAILED
}

model Diagram {
  id           String        @id @default(cuid())
  repositoryId String
  type         DiagramType
  status       DiagramStatus @default(PENDING)
  definition   String?       @db.Text
  nodes        Json?
  edges        Json?
  error        String?
  generatedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, type])
  @@index([repositoryId])
}
